# Cadena de conexión a PostgreSQL.
# Local:  postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Neon:   postgresql://usuario:clave@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Contraseña del panel de administración (/admin)
# ⚠️ CÁMBIALA antes de publicar en internet
ADMIN_PASSWORD=admin123

# Horas que dura una sesión de administrador (por defecto: 8, máximo: 720)
# Puedes usar 1 para pedir contraseña con más frecuencia.
ADMIN_SESSION_HOURS=8
